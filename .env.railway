# 9Router Railway deployment environment
# Copy to .env and fill in secrets before deploying, or set in Railway dashboard

# REQUIRED - generate strong random values
JWT_SECRET=
INITIAL_PASSWORD=
API_KEY_SECRET=
MACHINE_ID_SALT=

# Railway provides these automatically - do not set manually
# PORT=
# RAILWAY_GIT_COMMIT_SHA=
# RAILWAY_STATIC_URL= (your-app.up.railway.app)
# RAILWAY_ENVIRONMENT=production

# Production settings
NODE_ENV=production
HOSTNAME=0.0.0.0
DATA_DIR=/app/data

# Security - Railway provides HTTPS, so cookies must be secure
AUTH_COOKIE_SECURE=true

# Base URL - set to your Railway static URL after first deploy
# BASE_URL=https://your-app.up.railway.app
# NEXT_PUBLIC_BASE_URL=https://your-app.up.railway.app
# CLOUD_URL=https://your-app.up.railway.app
# NEXT_PUBLIC_CLOUD_URL=https://your-app.up.railway.app

# Optional features
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
REQUIRE_API_KEY=false

# Optional proxy (uncomment if needed)
# HTTP_PROXY=
# HTTPS_PROXY=
# ALL_PROXY=
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG for web search provider
# SEARXNG_URL=
